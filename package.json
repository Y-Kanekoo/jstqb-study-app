{
  "name": "jstqb-study-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/patch-web-html.mjs",
    "preview:web": "node scripts/serve-spa.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:content": "vitest run src/content/questions.test.ts src/content/content-contract.test.ts",
    "test:contracts": "vitest run src/contracts/exam-mode.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "check:any": "node scripts/check-no-any.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:security-exceptions": "node scripts/check-security-exceptions.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "content:verify": "node scripts/verify-content-export.mjs",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "check:pages": "node scripts/verify-pages-build.mjs",
    "check": "pnpm check:any && pnpm check:secrets && pnpm check:security-exceptions && pnpm lint && pnpm typecheck && pnpm test && pnpm build:web"
  },
  "dependencies": {
    "@expo-google-fonts/biz-udpgothic": "^0.4.2",
    "@expo-google-fonts/noto-sans-jp": "^0.4.3",
    "@supabase/supabase-js": "^2.112.2",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "idb": "^8.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
