{
  "parse": [
    {"name":"bare percent", "input":"q=%", "expected":{"q":"%"}},
    {"name":"non-hex escape", "input":"q=%G1", "expected":{"q":"%G1"}},
    {"name":"truncated escape", "input":"q=%A", "expected":{"q":"%A"}},
    {"name":"truncated UTF-8", "input":"q=%E0%A4", "expected":{"q":"%E0%A4"}, "expoExpected":{"q":"�"}},
    {"name":"invalid continuation", "input":"q=%F0%28%8C%28", "expected":{"q":"%F0(%8C("}, "expoExpected":{"q":"�(�("}},
    {"name":"surrogate UTF-8", "input":"q=%ED%A0%80", "expected":{"q":"%ED%A0%80"}, "expoExpected":{"q":"���"}},
    {"name":"overlong UTF-8", "input":"q=%C0%AF", "expected":{"q":"%C0%AF"}, "expoExpected":{"q":"��"}},
    {"name":"legacy replacement", "input":"q=%C2", "expected":{"q":"�"}},
    {"name":"invalid BOM", "input":"q=%FE%FF", "expected":{"q":"��"}},
    {"name":"malformed fallback does not recursively decode newly formed escapes", "input":"q=%25%34%31%FE%FD", "expected":{"q":"%41%FE%FD"}, "expoExpected":{"q":"%41��"}},
    {"name":"Unicode and lower hex", "input":"q=%e6%97%a5%E6%9C%AC&emoji=%F0%9F%98%80", "expected":{"emoji":"😀","q":"日本"}},
    {"name":"literal and encoded plus", "input":"q=a+b&plus=%2B&nested=%252B", "expected":{"nested":"%2B","plus":"+","q":"a b"}},
    {"name":"duplicate order", "input":"q=first&q=second&q=first", "expected":{"q":["first","second","first"]}},
    {"name":"absent versus empty", "input":"bare&empty=&q&q=&q=3", "expected":{"bare":null,"empty":"","q":[null,"","3"]}, "expoExpected":{"bare":"","empty":"","q":["","","3"]}},
    {"name":"default bracket keys remain literal", "input":"q[]=a&q[]=b", "expected":{"q[]":["a","b"]}},
    {"name":"reserved and first equals", "input":"q=a%26b%3Dc&eq=a=b", "expected":{"eq":"a=b","q":"a&b=c"}},
    {"name":"empty key", "input":"=v&&a=", "expected":{"":"v","a":""}},
    {"name":"prototype names are data", "input":"__proto__=safe&constructor=value", "expected":{"__proto__":"safe","constructor":"value"}, "expoExpected":{}},
    {"name":"bracket arrays", "input":"q[]=a&q[]=b", "options":{"arrayFormat":"bracket"}, "expected":{"q":["a","b"]}},
    {"name":"index arrays", "input":"q[1]=b&q[0]=a", "options":{"arrayFormat":"index"}, "expected":{"q":["a","b"]}},
    {"name":"comma plus legacy boundary", "input":"q=%2B%2Cx", "options":{"arrayFormat":"comma"}, "expected":{"q":[" ","x"]}},
    {"name":"separator plus legacy boundary", "input":"q=%2B%7Cx", "options":{"arrayFormat":"separator","arrayFormatSeparator":"|"}, "expected":{"q":[" ","x"]}},
    {"name":"decoding disabled", "input":"q=a+b%2Bc&bad=%E0%A4", "options":{"decode":false}, "expected":{"bad":"%E0%A4","q":"a+b%2Bc"}}
  ],
  "stringify": [
    {"name":"repeated arrays, empty and null", "input":{"tag":["a","b"],"empty":"","bare":null}, "expected":"tag=a&tag=b&empty=&bare"},
    {"name":"Unicode, spaces, plus and strict punctuation", "input":{"q":"日本 +!()"}, "expected":"q=%E6%97%A5%E6%9C%AC%20%2B%21%28%29"},
    {"name":"empty array omitted", "input":{"a":[],"b":""}, "expected":"b="},
    {"name":"malformed text is encoded once", "input":{"q":"%E0%A4"}, "expected":"q=%25E0%25A4"},
    {"name":"insertion order", "input":{"z":"last","a":"first"}, "expected":"z=last&a=first"}
  ],
  "fragment": [
    {"input":"/learn#a+b", "expected":"a b"},
    {"input":"/learn#a%2Bb", "expected":"a+b"},
    {"input":"/learn#%E0%A4", "expected":"%E0%A4"}
  ]
}
